// TableTalk AI — Prisma schema
// Database: PostgreSQL (Supabase or any Postgres instance)
// Connection URL via DATABASE_URL env var

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenants ─────────────────────────────────────────────────────────────────

model Restaurant {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique // used in URLs and account routing
  phone               String?
  address             String?
  website             String?
  logo_data_url       String?  @db.Text
  catering_available  Boolean  @default(false)
  twilio_number       String?  // assigned Twilio phone number (E.164)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  users          User[]
  menuItems      MenuItem[]
  menuCategories MenuCategory[]
  customizations Customization[]
  hours          Hours?
  taxRates       TaxRate?
  faqs           Faq[]
  orders         Order[]
  leads          Lead[]
  callLogs       CallLog[]
  voiceSettings  VoiceSettings?
  subscription   Subscription?

  @@map("restaurants")
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  password_hash String
  restaurant_id String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  created_at    DateTime   @default(now())

  @@map("users")
}

// ─── Menu ─────────────────────────────────────────────────────────────────────

model MenuItem {
  id                String            @id @default(cuid())
  restaurant_id     String
  restaurant        Restaurant        @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  name              String
  description       String?
  price             Decimal           @db.Decimal(10, 2)
  category          String
  prep_time_minutes Int               @default(10)
  availability      String            @default("in_stock") // in_stock | sold_out_today | sold_out_indefinitely
  position          Int               @default(0)
  created_at        DateTime          @default(now())

  customizations    Customization[]
  orderItems        OrderItem[]

  @@index([restaurant_id])
  @@index([restaurant_id, category])
  @@map("menu_items")
}

model MenuCategory {
  id            String     @id @default(cuid())
  restaurant_id String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  name          String
  position      Int        @default(0)

  @@unique([restaurant_id, name])
  @@index([restaurant_id])
  @@map("menu_categories")
}

model Customization {
  id            String     @id @default(cuid())
  restaurant_id String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  menu_item_id  String
  menuItem      MenuItem   @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  name          String
  price_delta   Decimal    @default(0) @db.Decimal(10, 2)
  created_at    DateTime   @default(now())

  @@index([restaurant_id])
  @@index([menu_item_id])
  @@map("customizations")
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Hours {
  restaurant_id String     @id
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  mon           String?
  tue           String?
  wed           String?
  thu           String?
  fri           String?
  sat           String?
  sun           String?
  updated_at    DateTime   @updatedAt

  @@map("hours")
}

model TaxRate {
  restaurant_id          String     @id
  restaurant             Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  food_beverage_rate     Decimal    @default(0) @db.Decimal(6, 4)
  sales_rate             Decimal    @default(0) @db.Decimal(6, 4)
  updated_at             DateTime   @updatedAt

  @@map("tax_rates")
}

model Faq {
  id            String     @id @default(cuid())
  restaurant_id String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  question      String
  answer        String     @db.Text
  position      Int        @default(0)
  created_at    DateTime   @default(now())

  @@index([restaurant_id])
  @@map("faqs")
}

model VoiceSettings {
  restaurant_id   String     @id
  restaurant      Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  mode            String     @default("backup") // backup | full
  transfer_number String     @default("")
  mode_verified   Boolean    @default(false)
  updated_at      DateTime   @updatedAt

  @@map("voice_settings")
}

// ─── Operations ──────────────────────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  restaurant_id String
  restaurant    Restaurant  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  customer_name String
  phone         String?
  order_size    String      // small | large
  subtotal      Decimal     @db.Decimal(10, 2)
  tax_total     Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  status        String      @default("pending") // pending | completed | cancelled
  ready_by      DateTime?
  notes         String?
  created_at    DateTime    @default(now())
  completed_at  DateTime?

  items         OrderItem[]

  @@index([restaurant_id])
  @@index([restaurant_id, status])
  @@map("orders")
}

model OrderItem {
  id                 String    @id @default(cuid())
  order_id           String
  order              Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item_id       String?
  menuItem           MenuItem? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)
  item_name          String
  quantity           Int
  unit_price         Decimal   @db.Decimal(10, 2)
  customization_ids  String[]  @default([]) // stored as array of customization IDs
  customization_names String[] @default([]) // denormalized for display
  notes              String?

  @@index([order_id])
  @@map("order_items")
}

model Lead {
  id            String     @id @default(cuid())
  restaurant_id String
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  lead_type     String     // catering | large_order
  customer_name String
  phone         String?
  event_date    String
  guest_count   Int
  notes         String?
  created_at    DateTime   @default(now())

  @@index([restaurant_id])
  @@map("leads")
}

model CallLog {
  id                   String     @id @default(cuid())
  restaurant_id        String
  restaurant           Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  call_sid             String     @unique
  caller_number        String?
  mode                 String     @default("unknown") // backup | full | unknown
  status               String     @default("completed")
  duration_seconds     Int        @default(0)
  started_at           DateTime
  ended_at             DateTime?
  transcript           Json       @default("[]") // { role, content }[]
  transfer_attempted   Boolean    @default(false)
  transfer_answered    Boolean    @default(false)
  recording_url        String?

  @@index([restaurant_id])
  @@map("call_logs")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Subscription {
  id                      String     @id @default(cuid())
  restaurant_id           String     @unique
  restaurant              Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  stripe_customer_id      String?    @unique
  stripe_subscription_id  String?    @unique
  plan                    String     @default("standard") // standard | (future tiers)
  status                  String     @default("trialing") // trialing | active | past_due | canceled | unpaid
  trial_ends_at           DateTime?
  current_period_end      DateTime?
  minute_cap              Int        @default(500)   // minutes per billing period
  minutes_used            Int        @default(0)
  overage_rate_cents      Int        @default(5)     // cents per minute over cap
  created_at              DateTime   @default(now())
  updated_at              DateTime   @updatedAt

  @@index([stripe_customer_id])
  @@map("subscriptions")
}

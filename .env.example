# Database (Postgres — Supabase or any Postgres instance)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tabletalk

# AI provider
ANTHROPIC_API_KEY=sk-ant-...

# Auth
SESSION_SECRET=change-me-in-production

# Restaurant data (defaults to deensbistro_test)
RESTAURANT_ACCOUNT_ID=deensbistro_test

# Twilio Voice (required for real phone calls — not needed for chat widget)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15405550100
TWILIO_TRANSFER_NUMBER=+15405550199

# SMS notifications
OWNER_PHONE_NUMBER=+15405550100   # owner's cell — receives order tickets and leads
STORE_NAME=Deen's Bistro          # used in customer confirmation SMS
RESTAURANT_TIMEZONE=America/New_York
